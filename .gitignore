# Build / Output papkalari
build/
dist/
# `lib/` SHU LOYIHADA MANBA KOD, build chiqishi EMAS —
# shuning uchun e'tiborsiz qoldirilmaydi (2026-08-19).
#
# Bu qator ko'p tilli shablondan kelgan edi: Python va ba'zi JS
# kutubxonalarida `lib/` haqiqatan build papkasi. Next.js loyihasida esa
# u yerda `content.ts`, `auth.ts`, `types.ts`, `curriculum.ts` turadi.
# Natijasi Vercel'da chiqdi: repoda `lib/` yo'q edi va build 12 ta
# "Module not found: Can't resolve '@/lib/...'" xatosi bilan yiqildi.
# lib/   <- ATAYLAB o'chirilgan, yuqoridagi izohga qarang
out/
.next/
.nuxt/
.vuepress/dist
.serverless/
.cache/

# Test koveraj fayllari
